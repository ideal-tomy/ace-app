rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailSignedInUser() {
      return isSignedIn() && request.auth.token.email != null;
    }

    function isStoreAdmin(storeId) {
      return isEmailSignedInUser() ||
        (
          isSignedIn() &&
          request.auth.token.email != null &&
          exists(/databases/$(database)/documents/admins/$(request.auth.token.email))
        );
    }

    function hasStoreRole(storeId, role) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/stores/$(storeId)/users/$(request.auth.uid)) &&
        (
          role in get(/databases/$(database)/documents/stores/$(storeId)/users/$(request.auth.uid)).data.moduleRoles ||
          'both' in get(/databases/$(database)/documents/stores/$(storeId)/users/$(request.auth.uid)).data.moduleRoles
        );
    }

    function canAccounting(storeId) {
      return isStoreAdmin(storeId) || hasStoreRole(storeId, 'accounting');
    }

    /// 経費の新規投稿（自分の UID で createdBy 必須）
    function canPostExpense(storeId) {
      return isStoreAdmin(storeId) ||
        hasStoreRole(storeId, 'expense') ||
        hasStoreRole(storeId, 'both') ||
        hasStoreRole(storeId, 'expense_submit');
    }

    function canReadOwnExpense(storeId) {
      return canPostExpense(storeId) &&
        resource.data.createdBy == request.auth.uid;
    }

    match /stores/{storeId} {
      // 管理情報は店舗管理者のみが更新可能。
      allow read: if isSignedIn();
      allow create, update, delete: if isStoreAdmin(storeId);

      match /admins/{adminUid} {
        allow read: if isStoreAdmin(storeId);
        allow create, update, delete: if isStoreAdmin(storeId);
      }

      match /users/{uid} {
        allow read: if isStoreAdmin(storeId) || (isSignedIn() && request.auth.uid == uid);
        allow create, update, delete: if isStoreAdmin(storeId);
      }

      match /menus/{menuId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isStoreAdmin(storeId);
      }

      match /customers/{customerId} {
        allow read, write: if isSignedIn();
      }

      match /checks/{checkId} {
        allow read: if canAccounting(storeId);
        allow create: if canAccounting(storeId) &&
          request.resource.data.status == 'open';
        allow update: if canAccounting(storeId) && (
          // 通常スタッフは open の伝票を open のまま更新可能（注文追加/取消の合計更新など）。
          (
            resource.data.status == 'open' &&
            request.resource.data.status == 'open'
          ) ||
          // 支払い確定（status変更）は管理者のみ許可。
          isStoreAdmin(storeId)
        );
        allow delete: if isStoreAdmin(storeId);

        match /items/{itemId} {
          allow read, write: if canAccounting(storeId);
        }
      }

      match /accounting_entries/{entryId} {
        allow read, create, update: if canAccounting(storeId);
        allow delete: if isStoreAdmin(storeId);
      }

      match /expense_entries/{entryId} {
        allow read: if isStoreAdmin(storeId) ||
          canReadOwnExpense(storeId);

        // memo / accountItemId は任意。その他フィールドのみ拒否しないよう hasAll で必須キーのみ検証する。
        allow create: if canPostExpense(storeId) &&
          request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.keys().hasAll(['date', 'category', 'amount', 'createdBy', 'updatedAt']);

        allow update: if isStoreAdmin(storeId) ||
          (
            canReadOwnExpense(storeId) &&
            request.resource.data.createdBy == resource.data.createdBy
          );

        allow delete: if isStoreAdmin(storeId);
      }
    }

    match /admins/{adminEmail} {
      allow read: if isSignedIn() && request.auth.token.email == adminEmail;
      allow create, update, delete: if false;
    }

    // 既存のトップレベル構造を閉じる（移行後の誤アクセス防止）。
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
